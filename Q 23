#include <stdio.h>

int main() {
    int days;
    int fine;

    printf("Enter number of late days: ");
    scanf("%d", &days);

    if (days <= 5) {
        fine = days * 2;
        printf("Fine = Rs.%d", fine);
    }
    else if (days <= 15) {
        fine = (5 * 2) + ((days - 5) * 4);
        printf("Fine = Rs.%d", fine);
    }
    else if (days <= 35) {
        fine = (5 * 2) + (10 * 4) + ((days - 15) * 6);
        printf("Fine = Rs.%d", fine);
    }
    else {
        printf("Membership Cancelled.");
    }

    return 0;
}

