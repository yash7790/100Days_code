#include <stdio.h>

int main() {
    int n, original, first, last, divisor = 1, middle, result;

    printf("Enter a number: ");
    scanf("%d", &n);

    original = n;

    last = n % 10;

    while (n >= 10) {
        n = n / 10;
        divisor = divisor * 10;
    }

    first = n;

    middle = (original % divisor) / 10;

    result = last * divisor + middle * 10 + first;

    printf("Number after swapping = %d", result);

    return 0;
}
