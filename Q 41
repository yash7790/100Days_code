#include <stdio.h>

int main() {
    int n, first, last, middle, divisor = 1, result;

    printf("Enter a number: ");
    scanf("%d", &n);

    last = n % 10;

    while (n >= 10) {
        n = n / 10;
        divisor = divisor * 10;
    }

    first = n;

    middle = (n * divisor);

    result = last * divisor + middle;

    printf("Number after swapping = %d", result);

    return 0;
}
